# Purpose: Optional shared defaults for the whole monorepo (no secrets).
# Interactions: Copy to .env only for values shared across apps or commands.
# The backend loads this file first, then apps/backend/.env, so backend-specific
# values in apps/backend/.env override duplicate values from this root file.
#
# Put backend secrets and RAG settings in apps/backend/.env.
# See apps/backend/.env.example for:
# DATABASE_URL, SUPABASE_*, GEMINI_API_KEY, EMBEDDING_*, LLM_*, RAG_*, uploads, CORS.
#
# Put frontend browser config in apps/frontend/.env.local.
# See apps/frontend/.env.local.example for NEXT_PUBLIC_API_URL.

# Optional backend server defaults
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
