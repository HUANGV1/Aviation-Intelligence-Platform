# Purpose: Backend-specific environment variable template (no secrets).
# Interactions: Copy to apps/backend/.env. Loaded by app/config.py for database,
# CORS, and local PDF upload settings used by main.py and document_storage.py.
#
# Supabase (hosted Postgres + pgvector)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Local PDF storage (relative to repo root)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Embeddings (Gemini free tier friendly defaults)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=4
EMBEDDING_REQUEST_TOKEN_BUDGET=6000
EMBEDDING_TOKENS_PER_MINUTE=25000
GEMINI_API_KEY=your-gemini-api-key

NEXT_PUBLIC_API_URL=http://localhost:8000
