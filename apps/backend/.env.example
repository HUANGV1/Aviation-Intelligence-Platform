# Supabase
# See docs/SUPABASE_SETUP.md for setup steps.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=# Paste Session pooler URI from Supabase Dashboard -> Settings -> Database -> Connection string
# Use Session pooler (NOT Direct). If password has # encode it as %23
# Docker Compose reads this value (do not leave blank when using `docker compose up`).
DATABASE_URL=

# Local PDF storage (relative to repo root)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

BACKEND_HOST=127.0.0.1 # 0.0.0.0 for all interfaces, 127.0.0.1 for only this machine
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=4
EMBEDDING_REQUEST_TOKEN_BUDGET=6000
EMBEDDING_TOKENS_PER_MINUTE=25000
GEMINI_API_KEY=

# LLM answer generation (Gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.cache/llm_cache.json
LLM_CACHE_TTL_SECONDS=21600
RAG_MIN_SIMILARITY=0.35
RAG_ANSWER_TOP_K=6

# Set to 0 to send full retrieved chunk text to Gemini.
RAG_MAX_SOURCE_TEXT_CHARS=1800

# Agent orchestration
AGENT_MAX_TOOL_ROUNDS=3
AGENT_TEMPERATURE=0.3
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MEMORY_MAX_TURNS=5

# Operational aviation APIs (server-side only; never expose in frontend)
AVIATION_WEATHER_BASE_URL=https://aviationweather.gov
OPERATIONAL_CACHE_TTL_SECONDS=300

SEARCH_DEFAULT_TOP_K=
SEARCH_MAX_TOP_K=